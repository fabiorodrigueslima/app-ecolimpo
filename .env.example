# Copie este arquivo para ".env.local" e preencha com os dados do Supabase
# (Project Settings > API Keys / Data API). O .env.local NÃO vai para o Git.
#
# Use só a chave PÚBLICA ("publishable", começa com sb_publishable_, ou a antiga "anon").
# NUNCA coloque aqui a chave "secret" ou "service_role".

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI
