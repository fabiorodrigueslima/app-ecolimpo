# Copie este arquivo para ".env.local" e preencha. O .env.local NÃO vai para o Git.
# Na Vercel, as mesmas variáveis vão em: Project > Settings > Environment Variables.

# ---------- App (vão junto para o celular: só valores PÚBLICOS) ----------
# Supabase: Project Settings > API Keys / Data API.
# Use só a chave PÚBLICA ("publishable", começa com sb_publishable_, ou a antiga "anon").
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# Lembrete: gerado por "npm.cmd run gerar-chaves" (grava direto no .env.local).
VITE_VAPID_PUBLIC_KEY=GERADA_PELO_SCRIPT

# ---------- Servidor (SECRETAS: só no .env.local e na Vercel) ----------
# Chave SECRETA do Supabase (sb_secret_...). Nunca no código, nunca no app.
SUPABASE_SECRET_KEY=sb_secret_COLE_AQUI
VAPID_PRIVATE_KEY=GERADA_PELO_SCRIPT
LEMBRETE_SEGREDO=GERADA_PELO_SCRIPT
